# --- Attendance backend ---
DATABASE_URL=sqlite:///./attendance.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=43200

# --- Biometric Verify integration (../contactless-fingerprint-system) ---
# Base URL of the running Biometric Verify service.
BIOMETRIC_BASE_URL=https://127.0.0.1:5000
# A tenant API key with the "verify" role (created in /admin).
BIOMETRIC_API_KEY=fk_your_verify_key
# The tenant's signing secret, used to validate the HMAC on verify responses.
BIOMETRIC_SIGNING_SECRET=your_tenant_signing_secret
# Set false only for local self-signed dev servers.
BIOMETRIC_VERIFY_TLS=true

# --- Attendance policy ---
GEOFENCE_DEFAULT_RADIUS_M=70
MIN_VERIFY_SCORE=0.40
